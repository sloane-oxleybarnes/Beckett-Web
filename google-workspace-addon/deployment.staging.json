{
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.action",
    "https://www.googleapis.com/auth/gmail.addons.current.action.compose",
    "https://www.googleapis.com/auth/userinfo.email",
    "openid"
  ],
  "addOns": {
    "common": {
      "name": "Beckett Staging",
      "logoUrl": "https://www.meetbeckett.co/brand/beckett-icon.png",
      "layoutProperties": {
        "primaryColor": "#8B5310",
        "secondaryColor": "#BA7517"
      },
      "addOnWidgetSet": {
        "usedWidgets": [
          "STYLED_BUTTONS",
          "FIXED_FOOTER"
        ]
      },
      "homepageTrigger": {
        "runFunction": "https://beckett-git-staging-sloane-s-projects1.vercel.app/api/google-workspace-addon/home"
      },
      "universalActions": [
        {
          "label": "Open Beckett",
          "openLink": "https://beckett-git-staging-sloane-s-projects1.vercel.app/dashboard"
        },
        {
          "label": "Beckett settings",
          "openLink": "https://beckett-git-staging-sloane-s-projects1.vercel.app/dashboard/settings"
        },
        {
          "label": "Privacy",
          "openLink": "https://www.meetbeckett.co/privacy"
        },
        {
          "label": "Get help",
          "openLink": "mailto:hello@meetbeckett.co"
        }
      ],
      "openLinkUrlPrefixes": [
        "https://beckett-git-staging-sloane-s-projects1.vercel.app/",
        "https://www.meetbeckett.co/"
      ]
    },
    "gmail": {
      "contextualTriggers": [
        {
          "unconditional": {},
          "onTriggerFunction": "https://beckett-git-staging-sloane-s-projects1.vercel.app/api/google-workspace-addon/message"
        }
      ]
    },
    "httpOptions": {
      "granularOauthPermissionSupport": "OPT_IN"
    }
  }
}
