{
  "manifest_version": 3,
  "name": "Beckett",
  "version": "3.1.0",
  "description": "Workplace communication coaching for Slack and supported non-email pages.",
  "permissions": [
    "storage",
    "identity",
    "scripting",
    "activeTab",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://app.slack.com/*",
    "https://meetbeckett.co/*",
    "https://www.meetbeckett.co/*",
    "https://slack.com/api/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["content/slack.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
