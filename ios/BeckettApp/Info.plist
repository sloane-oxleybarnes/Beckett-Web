<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BECKETT_API_BASE_URL</key>
	<string>$(BECKETT_API_BASE_URL)</string>
	<key>APP_GROUP_IDENTIFIER</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>KEYCHAIN_GROUP_IDENTIFIER</key>
	<string>$(KEYCHAIN_GROUP_IDENTIFIER)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Beckett uses your microphone only while you practice a spoken conversation.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Beckett converts what you say during Practice into text so the simulated person can respond.</string>
	<key>CFBundleDisplayName</key>
	<string>Beckett</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
