{
  "name": "beckett-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node --test tests/architecture-guardrails.test.mjs tests/auth-next.test.mjs",
    "test:onboarding": "node --test tests/beta-consent.test.mjs",
    "test:google-workspace-addon": "node --test tests/google-connection-boundaries.test.mjs tests/google-workspace-addon-diagnostics.test.mjs tests/google-workspace-addon-link.test.mjs tests/google-workspace-gmail-context.test.mjs tests/google-workspace-gmail-draft-action.test.mjs",
    "test:slack": "node --test tests/slack-guest-routing.test.mjs tests/slack-api-retry.test.mjs tests/slack-command-copy.test.mjs tests/slack-prep-copy.test.mjs tests/slack-guided-intent.test.mjs tests/slack-zero-copy.test.mjs tests/slack-thread-rehydration.test.mjs",
    "demo:plan": "node scripts/demo-seed.js --plan",
    "demo:seed:gmail": "node scripts/demo-seed.js --gmail",
    "demo:seed:slack": "node scripts/demo-seed.js --slack",
    "demo:seed:contacts": "node scripts/demo-seed.js --contacts",
    "demo:seed:all": "node scripts/demo-seed.js --all",
    "package:extension": "node scripts/package-extension.js",
    "commit:check": "node scripts/validate-conventional-commit.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "security:audit": "npm audit --audit-level=high",
    "db:types": "npx supabase@2.113.0 gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > lib/database.types.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:architecture && npm run test:onboarding && npm run test:google-workspace-addon && npm run test:slack && npm run build"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.18.0",
    "@sentry/nextjs": "^10.57.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "google-auth-library": "^11.0.0",
    "loops": "^6.3.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  }
}
