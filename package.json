{
  "name": "beckett-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "performance:baseline": "node scripts/measure-web-vitals.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node --test tests/architecture-guardrails.test.mjs tests/auth-next.test.mjs",
    "test:all": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:onboarding": "node --test tests/beta-consent.test.mjs",
    "test:outlook": "node --test tests/outlook-marketplace-readiness.test.mjs",
    "validate:outlook": "office-addin-manifest validate -p docs/outlook-addin-manifest-production.xml",
    "verify:outlook": "npm run test:outlook && npm run validate:outlook",
    "test:google-workspace-addon": "node --test tests/google-connection-boundaries.test.mjs tests/google-workspace-addon-diagnostics.test.mjs tests/google-workspace-addon-link.test.mjs tests/google-workspace-gmail-context.test.mjs tests/google-workspace-gmail-draft-action.test.mjs",
    "test:slack": "node --test tests/slack-guest-routing.test.mjs tests/slack-api-retry.test.mjs tests/slack-command-copy.test.mjs tests/slack-prep-copy.test.mjs tests/slack-guided-intent.test.mjs tests/slack-zero-copy.test.mjs tests/slack-thread-rehydration.test.mjs tests/slack-coaching-profile.test.mjs tests/slack-response-format.test.mjs tests/slack-diagnostics.test.mjs tests/slack-message-shortcut.test.mjs",
    "test:teams": "node --test tests/teams-message-actions.test.mjs tests/teams-action-token.test.mjs tests/teams-manifest.test.mjs",
    "eval:slack-profiles": "node --env-file-if-exists=.env.local scripts/evaluate-slack-coaching-profiles.mjs",
    "demo:plan": "node scripts/demo-seed.cjs --plan",
    "demo:seed:gmail": "node scripts/demo-seed.cjs --gmail",
    "demo:seed:slack": "node scripts/demo-seed.cjs --slack",
    "demo:seed:contacts": "node scripts/demo-seed.cjs --contacts",
    "demo:seed:all": "node scripts/demo-seed.cjs --all",
    "package:extension": "node scripts/package-extension.cjs",
    "package:teams": "node scripts/package-teams-app.mjs",
    "commit:check": "node scripts/validate-conventional-commit.mjs",
    "migrations:check": "node scripts/validate-migrations.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "security:audit": "npm audit --audit-level=high",
    "db:types": "npx supabase@2.113.0 gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > lib/database.types.ts",
    "db:types:check": "node scripts/check-database-types.mjs",
    "verify": "npm run lint && npm run typecheck && npm run migrations:check && npm run test:all && npm run build"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.18.0",
    "@microsoft/teams.apps": "^2.0.15",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "google-auth-library": "^11.0.2",
    "loops": "^6.3.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "office-addin-manifest": "2.1.6",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  }
}
